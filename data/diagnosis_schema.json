        {"value": "analysieren", "label": "Analysieren / verstehen"},
        {"value": "strategie", "label": "Strategie entwickeln"},
        {"value": "helfen", "label": "Gegenseitig helfen"},
        {"value": "planen", "label": "Konkret planen / umsetzen"},
        {"value": "solo", "label": "Einzelarbeit"}
      ]
    },
    {
