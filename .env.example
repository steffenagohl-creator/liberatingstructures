# Vorlage für die lokale .env – kopiere zu ".env" und setze echte Werte ein.
# Die echte .env wird NICHT committet (steht in .gitignore). Keine Secrets ins Repo!

# PostgreSQL (Docker-Dienst "db")
POSTGRES_DB=lsm
POSTGRES_USER=lsm
POSTGRES_PASSWORD=bitte-aendern

# Muss zu den Postgres-Werten oben passen (Host = Dienstname "db" im Compose-Netz)
DATABASE_URL=postgres://lsm:bitte-aendern@db:5432/lsm

# Django
DJANGO_SECRET_KEY=bitte-langen-zufallswert-einsetzen
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# LLM (provider-agnostisch, AP3) – Provider & Modell ausschließlich hier konfigurieren.
# Für Tests/Offline ohne Netz & Kosten: LLM_PROVIDER=stub
LLM_PROVIDER=mistral
LLM_MODEL=mistral-medium-latest
# Schlüssel: bevorzugt MISTRAL_API_KEY (ersatzweise das generische LLM_API_KEY).
MISTRAL_API_KEY=
# LLM_API_KEY=
# Optional: Timeout (Sekunden) und maximale Quality-Gate-Korrekturversuche.
# LLM_TIMEOUT=60
# MATCHMAKER_MAX_ITERATIONS=3
